export type CmeVisionNormalized = {
  screenshotType?: string
  asOfDate?: string

  underlyingFutures: Array<{
    symbol: string
    dte?: number
    settlement?: number
  }>

  optionSeries: Array<{
    symbol: string
    dte?: number
    underlying: string
  }>

  strikesRange?: {
    minStrike?: number
    maxStrike?: number
  }

  notableConcentrations: Array<{
    strike: number
    series: string
    type: "CALL" | "PUT"
    value: number
  }>

  unreadableOrMissingInformation?: string
}

function finiteNumber(value: unknown): number | undefined {
  if (typeof value === "number") {
    return Number.isFinite(value) ? value : undefined
  }

  if (typeof value === "string") {
    const parsed = Number(value.replace(/,/g, "").trim())
    return Number.isFinite(parsed) ? parsed : undefined
  }

  return undefined
}

export function normalizeCmeVision(
  input: unknown,
): CmeVisionNormalized {
  const source = input as Record<string, unknown>

  const underlyingFutures = Array.isArray(source.underlying_futures)
    ? source.underlying_futures
        .map((item) => {
          const value = item as Record<string, unknown>

          const symbol =
            typeof value.symbol === "string"
              ? value.symbol
              : ""

          const settlement = finiteNumber(
  value.future_settlement ?? value.settlement,
)
          const dte = finiteNumber(value.dte)

          if (!symbol) return null

          return {
            symbol,
            ...(dte !== undefined ? { dte } : {}),
            ...(settlement !== undefined ? { settlement } : {}),
          }
        })
        .filter(
          (
            item,
          ): item is {
            symbol: string
            dte?: number
            settlement?: number
          } => item !== null,
        )
    : []            
const optionSeries = underlyingFutures.flatMap((future) => {
  const sourceFuture = (
    source.underlying_futures as unknown[]
  ).find((item) => {
    const value = item as Record<string, unknown>

    return value.symbol === future.symbol
  }) as Record<string, unknown> | undefined

  if (!Array.isArray(sourceFuture?.option_series)) {
    return []
  }

  return sourceFuture.option_series
    .map((item) => {
      const value = item as Record<string, unknown>

      const symbol =
        typeof value.symbol === "string"
          ? value.symbol
          : ""

      if (!symbol) return null

      const dte = finiteNumber(value.dte)

      return {
        symbol,
        ...(dte !== undefined ? { dte } : {}),
        underlying: future.symbol,
      }
    })
    .filter(
      (
        item,
      ): item is {
        symbol: string
        dte?: number
        underlying: string
      } => item !== null,
    )
})
          

          

          
           
              
              

          
            
               
  const notableConcentrations =
    Array.isArray(source.important_concentrations)
      ? source.important_volume_or_oi_concentration
          .map((item) => {
            const text = String(item)

            const match = text.match(
              /^([A-Z0-9]+)\s+(\d+(?:\.\d+)?)\s+(CALL|PUT):\s*([\d,]+)$/i,
            )

            if (!match) return null

            const strike = finiteNumber(match[2])
            const value = finiteNumber(match[4])

            if (
              strike === undefined ||
              value === undefined
            ) {
              return null
            }

            return {
              strike,
              series: match[1],
              type: match[3].toUpperCase() as "CALL" | "PUT",
              value,
            }
          })
          .filter(
            (
              item,
            ): item is {
              strike: number
              series: string
              type: "CALL" | "PUT"
              value: number
            } => item !== null,
          )
      : []

  const range = source.strikes_range_visible as
    | Record<string, unknown>
    | undefined

  const minStrike = finiteNumber(range?.min_strike)
  const maxStrike = finiteNumber(range?.max_strike)

  return {
    screenshotType:
      typeof source.screenshot_type === "string"
        ? source.screenshot_type
        : undefined,

    asOfDate:
      typeof source.as_of_date === "string"
        ? source.as_of_date
        : undefined,

    underlyingFutures,

    optionSeries,

    ...(minStrike !== undefined || maxStrike !== undefined
      ? {
          strikesRange: {
            ...(minStrike !== undefined ? { minStrike } : {}),
            ...(maxStrike !== undefined ? { maxStrike } : {}),
          },
        }
      : {}),

    notableConcentrations,

    unreadableOrMissingInformation:
      typeof source.unreadable_or_missing_information === "string"
        ? source.unreadable_or_missing_information
        : undefined,
  }
}

