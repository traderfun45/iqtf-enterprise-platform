import type { MarketProvider, MarketQuote } from '../../providers/market/types.js'

type CacheEntry = {
  expiresAt: number
  value: MarketQuote
}

const CACHE_TTL_MS = 10_000

const cache = new Map<string, CacheEntry>()
const pending = new Map<string, Promise<MarketQuote>>()

export async function getCachedMarketQuote(
  providerName: string,
  symbol: string,
  provider: MarketProvider
): Promise<MarketQuote> {
  const key = `${providerName}:${symbol.toUpperCase()}`
  const now = Date.now()

  const cached = cache.get(key)

  if (cached && cached.expiresAt > now) {
    return cached.value
  }

  const existingRequest = pending.get(key)

  if (existingRequest) {
    return existingRequest
  }

  const request = provider.getQuote(symbol)
    .then((value) => {
      cache.set(key, {
        value,
        expiresAt: Date.now() + CACHE_TTL_MS
      })

      return value
    })
    .finally(() => {
      pending.delete(key)
    })

  pending.set(key, request)

  return request
}

export function clearMarketQuoteCache() {
  cache.clear()
  pending.clear()
}
