import type { FastifyInstance } from 'fastify'
import {
  createCmeMarketData,
  getLatestCmeMarketData,
  getCmeMarketDataHistory,
  type CmeMarketData,
} from '../db/cme.js'
import {
  analyzeCmeIntelligence,
} from '../services/cmeIntelligence.js'

export async function cmeRoutes(app: FastifyInstance) {
  app.post('/api/cme', async (request, reply) => {
    const body = request.body as CmeMarketData

    if (!body?.symbol || !body?.dataDate) {
      return reply.code(400).send({
        error: 'symbol and dataDate are required',
      })
    }

    const previous = getLatestCmeMarketData(
      body.symbol,
    )

    const history = getCmeMarketDataHistory(
      body.symbol,
      30,
    )

    const intelligence =
      body.settlementPrice !== undefined
        ? analyzeCmeIntelligence({
            price: body.settlementPrice,
            previousPrice: previous?.settlementPrice,
            volume: body.volume,
            previousVolume: previous?.volume,
            openInterest: body.openInterest,
            previousOpenInterest:
              previous?.openInterest,
   historicalVolumeChanges: history
  .map((item, index, items) => {
    const next = items[index + 1]

    if (
      item.volume === undefined ||
      next?.volume === undefined
    ) {
      return undefined
    }

    return item.volume - next.volume
  })
  .filter(
    (value): value is number =>
      value !== undefined,
  ),

historicalOIChanges: history
  .map((item, index, items) => {
    const next = items[index + 1]

    if (
      item.openInterest === undefined ||
      next?.openInterest === undefined
    ) {
      return undefined
    }

    return (
      item.openInterest -
      next.openInterest
    )
  })
  .filter(
    (value): value is number =>
      value !== undefined,
  ),
          })
        : null

    const data = createCmeMarketData({
      ...body,
      oiChange:
        body.oiChange ??
        intelligence?.openInterestChange,
      volumeZscore:
        body.volumeZscore ??
        intelligence?.volumeZscore,
      oiZscore:
        body.oiZscore ??
        intelligence?.oiZscore,
    })

    return reply.code(201).send({
      success: true,
      data,
      intelligence,
    })
  })

  app.get('/api/cme/latest', async (request) => {
    const query = request.query as {
      symbol?: string
    }

    const symbol = query.symbol ?? 'GC'

    const data = getLatestCmeMarketData(symbol)

    return {
      success: true,
      data,
    }
  })

  app.get('/api/cme/history', async (request) => {
    const query = request.query as {
      symbol?: string
      limit?: string
    }

    const symbol = query.symbol ?? 'GC'

    const limit = Math.min(
      Math.max(Number(query.limit ?? 30), 1),
      100,
    )

    return {
      success: true,
      data: getCmeMarketDataHistory(
        symbol,
        limit,
      ),
    }
  })
   app.get('/api/cme/analysis', async (request, reply) => {
    const query = request.query as {
      symbol?: string
    }

    const symbol = query.symbol ?? 'GC'

    const history = getCmeMarketDataHistory(
      symbol,
      100,
    )

    const latest = history[0]
    const previous = history[1]

    if (!latest?.settlementPrice) {
      return reply.code(404).send({
        error: 'No CME market data available',
      })
    }

    const historical = history.slice(1)

    const historicalVolumeChanges =
      historical
        .map((item, index, items) => {
          const next = items[index + 1]

          if (
            item.volume === undefined ||
            next?.volume === undefined
          ) {
            return undefined
          }

          return item.volume - next.volume
        })
        .filter(
          (value): value is number =>
            value !== undefined,
        )

    const historicalOIChanges =
      historical
        .map((item, index, items) => {
          const next = items[index + 1]

          if (
            item.openInterest === undefined ||
            next?.openInterest === undefined
          ) {
            return undefined
          }

          return (
            item.openInterest -
            next.openInterest
          )
        })
        .filter(
          (value): value is number =>
            value !== undefined,
        )

    const intelligence =
      analyzeCmeIntelligence({
        price: latest.settlementPrice,
        previousPrice:
          previous?.settlementPrice,

        volume: latest.volume,
        previousVolume:
          previous?.volume,

        openInterest:
          latest.openInterest,
        previousOpenInterest:
          previous?.openInterest,

        historicalVolumeChanges,
        historicalOIChanges,
      })

    return {
      success: true,
      symbol,
      data: latest,
      intelligence,
      historyStats: {
        records: history.length,
        volumeChangeSamples:
          historicalVolumeChanges.length,
        oiChangeSamples:
          historicalOIChanges.length,
      },
    }
  })
