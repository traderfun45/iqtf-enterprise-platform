export async function getCmeAnalysis(
  symbol = "GC"
): Promise<CmeAnalysis> {
  return apiGet<CmeAnalysis>(
    `/api/cme/analysis?symbol=${encodeURIComponent(symbol)}`,
    10000
  )
}

